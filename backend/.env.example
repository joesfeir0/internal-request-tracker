# PostgreSQL connection. For development use a separate Neon branch (for example "development"),
# never the production branch. DATABASE_URL is the pooled address (host contains -pooler);
# DIRECT_URL is the direct address, used for migrations and test setup.
# A local PostgreSQL works too: point both at postgresql://USER:PASSWORD@127.0.0.1:5432/request_tracker
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-BRANCH-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-BRANCH.REGION.aws.neon.tech/neondb?sslmode=require
# Optional: separate database for tests. Each test creates and drops its own temporary schema.
# TEST_DATABASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional limits protecting the free Gemini quota and the demo database
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=300
WRITE_REQUESTS_PER_MINUTE=60
